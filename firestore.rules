rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Checks that the caller's uid matches the ownerUid stored in settings/owner.
    function isOwner() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/settings/owner)
        && request.auth.uid
           == get(/databases/$(database)/documents/settings/owner).data.ownerUid;
    }

    function studentPortalEnabled() {
      return exists(/databases/$(database)/documents/settings/studentAccess)
        && get(/databases/$(database)/documents/settings/studentAccess).data.studentPortalEnabled
           == true;
    }

    function newStudentRequestsEnabled() {
      return exists(/databases/$(database)/documents/settings/studentAccess)
        && get(/databases/$(database)/documents/settings/studentAccess).data.newStudentRequestsEnabled
           == true;
    }

    // A Google-authenticated non-owner is only a *candidate* student until
    // the teacher explicitly approves them here — being authenticated is
    // NEVER sufficient on its own to read student-facing content. Missing
    // settings/studentAccess, a missing students/{uid} document, or a
    // status other than 'approved' (pending/blocked) all deny by default.
    function isApprovedStudent() {
      return isAuthenticated()
        && studentPortalEnabled()
        && exists(/databases/$(database)/documents/students/$(request.auth.uid))
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.status
           == 'approved';
    }

    // Only meaningful after isApprovedStudent() has confirmed
    // students/{uid} exists — callers must short-circuit on that first.
    // .get('classId', null) tolerates a legacy/partial document missing
    // the field, defaulting to "no class" rather than an evaluation error.
    function myStudentClassId() {
      return get(/databases/$(database)/documents/students/$(request.auth.uid))
        .data.get('classId', null);
    }

    // True only for an approved student (with the portal active) whose own
    // classId is one of the given classIds. `classIds` is always passed in
    // by the caller from resource/cross-doc data via .get('classIds', []),
    // so a program/lesson with no classIds field at all (legacy) or an
    // empty array both safely deny — never "visible to everyone" by
    // omission. A student with no classId of their own is denied too,
    // even if they are otherwise approved.
    function isClassmateOf(classIds) {
      return isApprovedStudent()
        && myStudentClassId() != null
        && classIds.hasAny([myStudentClassId()]);
    }

    // --- Modalità verifica (M3F-07) ---
    // True when Modalità verifica currently applies to `classId` — mirrors
    // isExamModeActiveForClass() in examMode.ts exactly, so client-side UI
    // decisions and server-side denial always agree. A missing
    // settings/studentAccess doc, a missing/malformed examMode field, an
    // unrecognized `scope`, or a `classes` scope with no matching id all
    // resolve to "not active" here — the same fail-safe-to-disabled default
    // the client normalizer uses, never "blocks everyone" by omission.
    // Deliberately NOT folded into isClassmateOf(): that helper also gates
    // publishedProjection/submissions, which Modalità verifica must never
    // touch (an online exam in progress always stays reachable).
    function examModeAppliesToClass(classId) {
      return classId != null
        && exists(/databases/$(database)/documents/settings/studentAccess)
        && get(/databases/$(database)/documents/settings/studentAccess).data.get('examMode', null) != null
        && get(/databases/$(database)/documents/settings/studentAccess).data.examMode.get('enabled', false) == true
        && (
          get(/databases/$(database)/documents/settings/studentAccess).data.examMode.get('scope', '') == 'all'
          || (
            get(/databases/$(database)/documents/settings/studentAccess).data.examMode.get('scope', '') == 'classes'
            && get(/databases/$(database)/documents/settings/studentAccess).data.examMode
                 .get('classIds', []).hasAny([classId])
          )
        );
    }

    // --- publicLessons active-import helper (HARD-02B-1) ---
    // Cross-document read of the parent program's `activeImportId`. A projection
    // is visible to a student only when its own `importId` equals this value, so
    // staging or superseded/stale projections are never readable by a non-owner
    // — not even via a direct get() with a known id. get() is memoized within a
    // single rule evaluation, so reusing this alongside the classIds get() on
    // the same program path does not add a billed read.
    function programActiveImportId(programId) {
      return get(/databases/$(database)/documents/programs/$(programId)).data
        .get('activeImportId', null);
    }

    // --- ANNOT-01 student lesson-notes helpers ---
    // Bare cross-doc data getter for the lesson projection a note is attached
    // to. Only ever called after exists(publicLessons/{id}) has been checked
    // by the caller (see canAccessLessonForNotes) — get() is memoized within
    // a single evaluation, so referencing it several times bills one read.
    function lessonNoteProjection(publicLessonId) {
      return get(/databases/$(database)/documents/publicLessons/$(publicLessonId)).data;
    }

    // The full authorization gate for a student's personal lesson notes,
    // reusing the existing student/import/exam-mode helpers rather than
    // duplicating their logic. Fail-closed and short-circuiting: an approved,
    // non-owner student with a class of their own, not under Modalità verifica
    // (globally or for their class), whose class is assigned to the note's
    // program, and only for a publicLessons projection that exists AND belongs
    // to that program's current activeImportId. A missing publicLesson or
    // program, a stale/superseded import, or a class not assigned to the
    // program all deny. The teacher/owner is denied here explicitly, and again
    // by the studentUid == request.auth.uid check at every match rule below.
    function canAccessLessonForNotes(publicLessonId) {
      return isApprovedStudent()
        && !isOwner()
        && myStudentClassId() != null
        && !examModeAppliesToClass(myStudentClassId())
        && exists(/databases/$(database)/documents/publicLessons/$(publicLessonId))
        && exists(/databases/$(database)/documents/programs/$(lessonNoteProjection(publicLessonId).programId))
        && lessonNoteProjection(publicLessonId).importId
             == programActiveImportId(lessonNoteProjection(publicLessonId).programId)
        && isClassmateOf(
             get(/databases/$(database)/documents/programs/$(lessonNoteProjection(publicLessonId).programId))
               .data.get('classIds', []));
    }

    // Course-level equivalent used by the lightweight lesson-note index. The
    // index has no lesson payload to resolve, so authorization is pinned to
    // the program path, its current active import, class assignment, portal
    // state and Modalità verifica.
    function canAccessProgramForNotes(programId, importId) {
      return isApprovedStudent()
        && !isOwner()
        && myStudentClassId() != null
        && !examModeAppliesToClass(myStudentClassId())
        && exists(/databases/$(database)/documents/programs/$(programId))
        && get(/databases/$(database)/documents/programs/$(programId)).data
             .get('activeImportId', null) == importId
        && isClassmateOf(
             get(/databases/$(database)/documents/programs/$(programId)).data
               .get('classIds', []));
    }

    // --- M3-full submission helpers (M3F-03) ---
    // Cross-document get() bypasses the read rules on /verifications/{docId}
    // itself (a student is never allowed a direct read there) — get()/exists()
    // in Rules evaluation always fetch the raw document server-side regardless
    // of what the caller's own read permissions would be. This mirrors the
    // publishedProjection class-gate pattern above, applied to submissions.
    function verificationData(verificationId) {
      return get(/databases/$(database)/documents/verifications/$(verificationId)).data;
    }

    // A submission may only be created/updated while its target verification
    // is simultaneously active, public and online-submittable. Closing the
    // verification (or ever toggling onlineEnabled off) immediately blocks
    // both new submissions and further edits to existing drafts, without any
    // change needed on the submission document itself.
    function verificationOnlineAndActive(verificationId) {
      return exists(/databases/$(database)/documents/verifications/$(verificationId))
        && verificationData(verificationId).status == 'active'
        && verificationData(verificationId).get('visibility', 'hidden') == 'public'
        && verificationData(verificationId).get('onlineEnabled', false) == true;
    }

    // Mirrors isClassmateOf(): independently re-checks isApprovedStudent() so
    // it stays safe to call on its own, not just after a caller-side guard.
    // config.classId is the source-of-truth class assignment (teacherSnapshot
    // duplicates it only for the student-facing title/className snapshot).
    function verificationClassMatches(verificationId) {
      return isApprovedStudent()
        && verificationData(verificationId).config.classId != null
        && verificationData(verificationId).config.classId == myStudentClassId();
    }

    // Exact suffix match (no regex): true only when `id` ends with literally
    // `_` + the caller's own uid — e.g. id `v1_abc` for uid `abc`, never for
    // uid `bc` or a different uid entirely. This is the strictest available
    // check for "this deterministic submissionId belongs to me", used to
    // authorize a get() on a submission/receipt path before the document
    // necessarily exists (see the M3F-04 preflight note on submissions
    // below) without ever falling back to a looser prefix/contains check.
    function idBelongsToCaller(id) {
      return id.size() > request.auth.uid.size()
        && id[id.size() - request.auth.uid.size() - 1:] == '_' + request.auth.uid;
    }

    // --- M4-01 helpers: manual correction ---
    // Mirrors verificationData(): a bare cross-doc data getter, kept as a
    // named function purely for readability at call sites below.
    function submissionData(submissionId) {
      return get(/databases/$(database)/documents/submissions/$(submissionId)).data;
    }

    function correctionData(submissionId) {
      return get(/databases/$(database)/documents/corrections/$(submissionId)).data;
    }

    // Mirrors correctionData(), but reads the correction as it will exist
    // AFTER the current atomic write commits — required to authorize a
    // correctionReturns create/update against a correction that is
    // transitioning to 'returned' in the very same batch (returnCorrection),
    // and to deny one against a correction that is (or remains) 'in_progress'
    // or 'completed' after the batch, e.g. a stale correctionReturns left
    // hidden by reopenCorrection. getAfter() reflects sibling writes only
    // when they are part of the same commit, same idiom already used for
    // submissions/submissionReceipts (see submissionReceipts create below).
    function correctionDataAfter(submissionId) {
      return getAfter(/databases/$(database)/documents/corrections/$(submissionId)).data;
    }

    function isValidSubmissionCorrectionStatus(status) {
      return status in ['submitted', 'in_progress', 'completed', 'returned'];
    }

    function isValidSubmissionCorrectionSummary(summary) {
      return summary is map
        && summary.keys().hasOnly(['totalPoints', 'maxPoints', 'percentage'])
        && summary.keys().hasAll(['totalPoints', 'maxPoints', 'percentage'])
        && summary.totalPoints is number
        && summary.maxPoints is number
        && summary.totalPoints >= 0
        && summary.maxPoints >= 0
        && summary.totalPoints <= summary.maxPoints
        && (
          (summary.maxPoints == 0 && summary.percentage == null)
          || (summary.maxPoints > 0
              && summary.percentage is int
              && summary.percentage >= 0
              && summary.percentage <= 100)
        );
    }

    function publicCorrectionStatusMatchesCorrection(submissionId, status) {
      let correctionStatus = correctionDataAfter(submissionId).status;
      return (correctionStatus == 'in_progress'
               && status in ['submitted', 'in_progress'])
        || correctionStatus == status;
    }

    // The exact CorrectionStatus transition graph from correctionContract.ts
    // (isValidCorrectionStatusTransition) — kept in sync by hand, since
    // Rules cannot import the TypeScript helper. Deliberately excludes
    // 'returned' -> 'completed' directly and 'in_progress' -> 'returned'
    // directly, same reasoning as the client-side helper.
    function isValidCorrectionTransition(from, to) {
      return (from == 'in_progress' && to == 'completed')
        || (from == 'completed' && to == 'returned')
        || (from == 'completed' && to == 'in_progress')
        || (from == 'returned' && to == 'in_progress');
    }

    // Minimal event integrity check (no deep validation of questionDeltas
    // content — see the documented Rules/service boundary above the
    // corrections match block): every correctionEvents write must declare a
    // (type, previousStatus, nextStatus) combination that is actually
    // reachable, mirroring exactly what correctionsService.ts ever writes.
    // 'scoreAdjusted' never changes status (in_progress -> in_progress, only
    // reachable after a reopen — the first pass writes no event at all,
    // enforced client-side by isReopenedCorrection, not re-derivable here
    // without deep evaluations inspection).
    function isValidCorrectionEventTypeStatus(type, previousStatus, nextStatus) {
      return (type == 'reopened'
              && (previousStatus == 'completed' || previousStatus == 'returned')
              && nextStatus == 'in_progress')
        || (type == 'returned' && previousStatus == 'completed' && nextStatus == 'returned')
        || (type == 'scoreAdjusted' && previousStatus == 'in_progress' && nextStatus == 'in_progress')
        // M5-04C: azzeramento della correzione — resta 'in_progress' (mai
        // completa/restituisce automaticamente).
        || (type == 'correctionCleared' && previousStatus == 'in_progress' && nextStatus == 'in_progress');
    }

    // --- settings/owner ---
    // First authenticated user to write becomes the owner (no existing doc).
    // Subsequent updates/deletes require ownerUid match.
    match /settings/owner {
      allow read: if isOwner();
      allow create: if isAuthenticated()
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isOwner();
    }

    // --- M5 technical configuration and run metadata (server-only) ---
    // Admin SDK bypasses Rules. No client, including the owner, may inspect or
    // mutate provider configuration, idempotency leases/results, or budget
    // ledger documents.
    match /settings/aiConfig {
      allow read, write: if false;
    }

    match /aiCorrectionRuns/{document=**} {
      allow read, write: if false;
    }

    match /aiBudgetLedger/{document=**} {
      allow read, write: if false;
    }

    // --- settings/ownerPublic (M3-lite) ---
    // Holds only `ownerUid`, readable by any authenticated user so the client
    // can resolve TeacherShell vs. StudentShell without exposing settings/owner
    // (classes, feature flags). Never authorizes anything on its own — every
    // protected resource above still checks isOwner() independently.
    // Created together with settings/owner during the same bootstrap claim.
    match /settings/ownerPublic {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasOnly(['ownerUid'])
                    && request.resource.data.ownerUid == request.auth.uid
                    && !exists(/databases/$(database)/documents/settings/owner);
      allow update, delete: if isOwner();
    }

    // --- settings/studentAccess (M3-lite) ---
    // Global switches gating every student read (see isApprovedStudent()).
    // Readable by any authenticated user — same pattern as
    // settings/ownerPublic above: RoleGate needs studentPortalEnabled and
    // newStudentRequestsEnabled to decide which screen to show a candidate
    // student (disabled / pending / requests-closed), and neither flag is
    // sensitive or authorizes anything on its own. The actual content gate
    // (isApprovedStudent()) re-reads this document itself via get(), so a
    // client can never bypass authorization by trusting its own read.
    // Write stays owner-only.
    match /settings/studentAccess {
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }

    // --- settings/publicLessonsMigration (M3F-08 backfill marker) ---
    // Owner-only in both directions: unlike ownerPublic/studentAccess above,
    // nothing here needs to be readable by a student — it exists purely so
    // LessonsView can decide whether to show the backfill trigger without
    // scanning every publicLessons document on each mount. Written only by
    // publicLessonsBackfillService, only after a run with zero failures.
    match /settings/publicLessonsMigration {
      allow read, write: if isOwner();
    }

    // --- settings/verificationProjectionMigration ---
    // Owner-only one-time marker for the cleanup of student projections left
    // orphaned by the historical non-cascading verification delete flow.
    match /settings/verificationProjectionMigration {
      allow read, write: if isOwner();
    }

    // --- students/{uid} (M3-lite approval roster) ---
    // uid == the student's own Firebase Auth uid. A Google-authenticated
    // non-owner with no document here is treated as 'pending' for
    // authorization purposes. The teacher has full read/write. A student
    // may read only their own document (needed by RoleGate to show
    // pending/blocked/approved screens) and may create it exactly once,
    // as an unmodified 'pending' request, only while
    // newStudentRequestsEnabled is true — never approve/block/unblock
    // themselves, change classId, or read anyone else's document. Once
    // the document exists, every subsequent write is an `update`, which
    // only the owner can perform — so a student can never modify their
    // own status/classId/ownerUid after the initial request.
    match /students/{uid} {
      allow read: if isOwner() || (isAuthenticated() && request.auth.uid == uid);
      allow update, delete: if isOwner();
      allow create: if (isOwner() && request.resource.data.ownerUid == request.auth.uid)
        || (
          isAuthenticated()
          && request.auth.uid == uid
          && newStudentRequestsEnabled()
          && request.resource.data.uid == uid
          && request.resource.data.ownerUid
             == get(/databases/$(database)/documents/settings/ownerPublic).data.ownerUid
          && request.resource.data.status == 'pending'
          && request.resource.data.classId == null
          && request.resource.data.keys().hasOnly(
               ['uid', 'ownerUid', 'email', 'displayName', 'status', 'classId', 'createdAt',
                'updatedAt', 'lastLoginAt'])
        );
    }

    // --- students/{studentUid}/lessonNotes/{publicLessonId} (ANNOT-01) ---
    // A student's strictly personal note for one public lesson — at most one
    // document per (student, lesson), guaranteed by the deterministic id
    // (== publicLessonId). These rules are self-contained: the parent
    // students/{uid} rules above do NOT propagate to this subcollection
    // (Firestore never inherits parent rules), so the teacher's owner-read on
    // students/{uid} grants NOTHING here — the note is unreadable to the
    // owner, to every other student, and to anonymous callers. Every
    // operation additionally requires request.auth.uid == studentUid AND the
    // full canAccessLessonForNotes() gate, which denies pending/blocked/
    // no-class/portal-disabled students, a class not assigned to the lesson's
    // program, a stale/inactive import, a missing program/publicLesson, and
    // ANY operation while Modalità verifica applies globally or to the class.
    // No didactic data (lesson body/title, class, name/email, pool, questions
    // or solutions) is ever stored or exposed here.
    match /students/{studentUid}/lessonNotes/{publicLessonId} {
      // Normal reads stay deterministic (`getDoc`). The separate, bounded
      // `list` rule below exists only for the one-time legacy index bootstrap;
      // unfiltered collection scans remain denied.
      allow get: if request.auth.uid == studentUid
        && canAccessLessonForNotes(publicLessonId);

      // Used only by the one-time per-course index bootstrap. A list rule
      // cannot safely resolve `publicLessonId` from the wildcard path (it is
      // not a concrete value while the query is authorized), so authorization
      // is derived from each note's immutable program/import identity. The
      // production query fixes both fields; an unbounded collection scan is
      // therefore still denied by Firestore's query/rules proof.
      allow list: if request.auth.uid == studentUid
        && resource.data.programId is string
        && resource.data.importId is string
        && canAccessProgramForNotes(resource.data.programId, resource.data.importId);

      // Create: exact closed key set, identity pinned to path/auth and to the
      // associated publicLesson projection, content a string within the
      // 20 000 limit, and both timestamps == request.time (a client can never
      // backdate createdAt or forge updatedAt).
      allow create: if request.auth.uid == studentUid
        && canAccessLessonForNotes(publicLessonId)
        && request.resource.data.keys().hasOnly([
             'studentUid', 'publicLessonId', 'programId', 'importId',
             'content', 'createdAt', 'updatedAt'
           ])
        && request.resource.data.keys().hasAll([
             'studentUid', 'publicLessonId', 'programId', 'importId',
             'content', 'createdAt', 'updatedAt'
           ])
        && request.resource.data.studentUid == studentUid
        && request.resource.data.publicLessonId == publicLessonId
        && request.resource.data.programId == lessonNoteProjection(publicLessonId).programId
        && request.resource.data.importId == lessonNoteProjection(publicLessonId).importId
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 20000
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      // Update: the note must exist and the student must still be authorized.
      // Only content + updatedAt may change; identity fields and createdAt are
      // immutable (enforced by the closed affectedKeys() set). Content stays a
      // string within the limit and updatedAt == request.time.
      allow update: if request.auth.uid == studentUid
        && canAccessLessonForNotes(publicLessonId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['content', 'updatedAt'])
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 20000
        && request.resource.data.updatedAt == request.time;

      // Delete: only the owning student, only in an authorized context (so a
      // note is undeletable during Modalità verifica or once the lesson is no
      // longer accessible — fail-closed, documented in the contract). Never
      // the teacher, never a recursive/cascading delete.
      allow delete: if request.auth.uid == studentUid
        && canAccessLessonForNotes(publicLessonId);
    }

    // --- lessonNoteIndexes (ANNOT-03B) ---
    // One privacy-minimal document per student/course. No note text or
    // didactic content; only current-import lesson ids with persisted notes.
    match /students/{studentUid}/lessonNoteIndexes/{programId} {
      // Authorize the deterministic path from the current program so a
      // missing or stale document can still be read as "missing" and safely
      // bootstrapped. Existing payload validity is enforced on every write.
      allow get: if request.auth.uid == studentUid
        && canAccessProgramForNotes(programId, programActiveImportId(programId));

      allow create: if request.auth.uid == studentUid
        && request.resource.data.keys().hasOnly([
             'studentUid', 'programId', 'importId', 'lessonIds', 'updatedAt'
           ])
        && request.resource.data.keys().hasAll([
             'studentUid', 'programId', 'importId', 'lessonIds', 'updatedAt'
           ])
        && request.resource.data.studentUid == studentUid
        && request.resource.data.programId == programId
        && canAccessProgramForNotes(programId, request.resource.data.importId)
        && request.resource.data.lessonIds is list
        && request.resource.data.lessonIds.size() <= 500
        && request.resource.data.updatedAt == request.time;

      allow update: if request.auth.uid == studentUid
        && resource.data.studentUid == studentUid
        && resource.data.programId == programId
        && request.resource.data.studentUid == studentUid
        && request.resource.data.programId == programId
        && request.resource.data.keys().hasOnly([
             'studentUid', 'programId', 'importId', 'lessonIds', 'updatedAt'
           ])
        && request.resource.data.keys().hasAll([
             'studentUid', 'programId', 'importId', 'lessonIds', 'updatedAt'
           ])
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['importId', 'lessonIds', 'updatedAt'])
        && canAccessProgramForNotes(programId, request.resource.data.importId)
        && request.resource.data.lessonIds is list
        && request.resource.data.lessonIds.size() <= 500
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // --- Teacher-owned collections ---
    match /classes/{classId} {
      allow read, update, delete: if isOwner();
      allow create: if isOwner() && request.resource.data.ownerUid == request.auth.uid;
    }

    // --- programs/{docId} (M3-lite student read, M3L-C) ---
    // Owner: full read/write, as always. An approved student may also read
    // the top-level program document — never its imports/** subcollection
    // (technical lessons, questionIndex, pool: still owner-only via the
    // second match below) — but only when the program's own classIds
    // includes the student's classId. A program with no classIds, or an
    // empty one, is never readable by any student. This is the query the
    // student client runs to discover which programs it may see:
    // where('classIds', 'array-contains', myClassId) — the rule mirrors
    // that exact condition so Firestore can validate the list request.
    // M3F-07: a student in a class currently under Modalità verifica loses
    // discovery of programs assigned to their own class — the exact same
    // condition the client UI hides Lezioni on (isExamModeActiveForClass()).
    // Interim risk (documented in sicurezza.md, resolved by M3F-08): this
    // denies Firestore discovery only — Storage still serves the lesson
    // Markdown directly to any authenticated non-owner and cannot yet apply
    // this same per-class check.
    match /programs/{docId} {
      allow read, write: if isOwner();
      allow read: if isClassmateOf(resource.data.get('classIds', []))
        && !examModeAppliesToClass(myStudentClassId());
    }
    match /programs/{programId}/{sub=**} {
      allow read, write: if isOwner();
    }

    // --- publicLessons (M3-lite) ---
    // Read-only projection of a lesson for the student portal. Never
    // contains poolStatus/poolStorageRef/questionCount or any pool-derived
    // field — see PublicLessonDoc. Owner: full read/write (written by the
    // import flow). Any other user: read-only, and only if they are an
    // approved student in the same class as the lesson's program
    // (isClassmateOf(), checked against the parent program's classIds via
    // get() — a lesson is never visible on its own, only through a program
    // the student's class is actually assigned to). Being an approved
    // student with the portal active is NOT enough by itself: without this
    // class check, any approved student could read every lesson of every
    // class, not just their own.
    //
    // Deliberately does NOT also check resource.data.ownerUid here (unlike
    // some other rules in this file): for a `list` query, Firestore can only
    // validate a condition against a field the query itself constrains
    // (here, only `programId` is), otherwise it cannot prove the query safe
    // and denies the whole request — the same reason the array-contains
    // "programs" rule above checks only classIds and nothing else. In this
    // single-docente system ownerUid is already implied by the program
    // lookup (a program only ever belongs to the one owner), so omitting it
    // costs nothing in practice.
    // M3F-07: same Modalità verifica gate as programs/{docId} above — a
    // lesson is never visible to a student whose class is currently
    // blocked, even though the underlying program document might otherwise
    // still list their classId.
    // HARD-02B-1: a non-owner may read a projection ONLY if its own
    // `importId` equals the parent program's current `activeImportId`. This is
    // the security boundary (the UI query filter is not): staging and
    // superseded/stale projections are denied to students even on a direct
    // get() with a known id, and a list query MUST constrain `importId`
    // (Firestore validates a list only against fields the query filters on —
    // the student query filters programId AND importId, see
    // studentLessonsService.ts). The owner keeps full read (active, staging and
    // legacy/stale alike) via the isOwner() branch.
    match /publicLessons/{lessonId} {
      allow read: if isOwner()
        || (
          exists(/databases/$(database)/documents/programs/$(resource.data.programId))
          && resource.data.importId == programActiveImportId(resource.data.programId)
          && isClassmateOf(
               get(/databases/$(database)/documents/programs/$(resource.data.programId))
                 .data.get('classIds', []))
          && !examModeAppliesToClass(myStudentClassId())
        );
      allow create, update: if isOwner() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isOwner();
    }

    match /verifications/{docId} {
      allow read: if isOwner();
      // Delete allowed for draft (discard) and closed (tidy up) — active is
      // an immutable snapshot and can only be closed, never deleted.
      allow delete: if isOwner()
        && (resource.data.status == 'draft' || resource.data.status == 'closed');
      allow create: if isOwner() && request.resource.data.ownerUid == request.auth.uid;
      // Draft: any owner update allowed.
      // Active: only close allowed; only status/closedAt/updatedAt may change.
      // Active/closed: visibility may be toggled without reopening the
      // verification. Closed public projections remain consultable and
      // downloadable, but submission Rules still require active status.
      // Active/closed: only studentPdfEnabled toggled (M3F-09) — see below.
      // Closed: no other update allowed (studentPdfEnabled is the sole
      // exception — a closed verification never reopens, but the teacher may
      // still control student PDF access on it).
      allow update: if isOwner() && resource.data.status == 'draft';
      allow update: if isOwner()
        && resource.data.status == 'active'
        && request.resource.data.status == 'closed'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'closedAt', 'updatedAt']);
      allow update: if isOwner()
        && (resource.data.status == 'active' || resource.data.status == 'closed')
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['visibility', 'updatedAt']);
      // Active: only onlineEnabled toggled (M3F-05 teacher control); only
      // onlineEnabled/updatedAt may change, status must stay 'active'.
      // Enabling online is denied when the verification has no class
      // assigned — mirrors verificationClassMatches(), which would deny
      // every submission anyway (config is immutable once active, so
      // resource.data.config.classId reflects the current assignment).
      allow update: if isOwner()
        && resource.data.status == 'active'
        && request.resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['onlineEnabled', 'updatedAt'])
        && request.resource.data.onlineEnabled is bool
        && (request.resource.data.onlineEnabled != true
            || resource.data.config.classId != null);
      // M3F-09: studentPdfEnabled controls only the student PDF download,
      // independent of status/visibility/onlineEnabled/config. Allowed on
      // 'active' AND 'closed' (draft already covered by the any-owner-update
      // rule above) — status itself must never change here, and this never
      // reopens a closed verification or changes visibility: setting it
      // true only matters once/if the verification is separately active +
      // public + class-assigned (see publishedProjection below).
      allow update: if isOwner()
        && (resource.data.status == 'active' || resource.data.status == 'closed')
        && request.resource.data.status == resource.data.status
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['studentPdfEnabled', 'updatedAt'])
        && request.resource.data.studentPdfEnabled is bool;
    }
    match /verifications/{verificationId}/{sub=**} {
      // read: owner only; write on sub-collections handled per-path in later milestones.
      // Note: {sub=**} can match the document itself (zero segments), so write is intentionally
      // omitted here — update semantics on /verifications/{docId} are enforced above.
      allow read: if isOwner();
    }

    // --- verifications/{id}/publishedProjection (M3-lite, class gate M3L-D) ---
    // Solution-free projection written at activation. `classId` and
    // `visibility` ARE deliberately duplicated here from the parent
    // verification (see PublishedProjectionDoc for the full rationale) —
    // proven necessary, not just convenient: a student discovers matching
    // verifications via a single collectionGroup('publishedProjection')
    // query (the parent /verifications/{docId} is never readable — it holds
    // config.questionRefs/teacherSnapshot, which a student must never see).
    // Empirically, TWO things are required for Firestore to authorize that
    // collectionGroup `list`, neither obvious from the single-document `get`
    // case that worked before M3L-D:
    //   1. every field the rule authorizes on must also be a field the
    //      query itself filters on (a cross-document get() back to the
    //      parent, e.g. to check `status`, does not validate here — the
    //      parent path segment isn't constrained by the query);
    //   2. the match block itself must use a recursive-wildcard prefix
    //      ({path=**}) rather than a fixed-depth one
    //      (verifications/{verificationId}) — Firestore does not register
    //      a fixed-depth match as eligible for a bare collectionGroup()
    //      list at all (it still works fine for get()/writes on a known
    //      path, and for list within one already-known parent — just not
    //      for collectionGroup). Confirmed empirically: even
    //      `allow read: if true` failed list validation under the
    //      fixed-depth pattern, and succeeded once switched to {path=**}.
    // `status` is duplicated in the projection for student UI semantics;
    // discovery remains intentionally constrained only by classId and
    // visibility so closed-public verifications stay readable. Submission
    // Rules independently require the parent verification to be active.
    // isClassmateOf()
    // already requires isApprovedStudent() internally — a verification
    // with no classId (resource.data.get('classId', null) == null) is
    // never visible to any student, never "visible to everyone" by
    // omission, mirroring programs.classIds (M3L-C). The student's own
    // discovery query must mirror this exact rule shape:
    // where('classId','==',myClassId) AND where('visibility','==','public')
    // — see studentVerificationsService.ts.
    match /{path=**}/publishedProjection/{docId} {
      allow read: if isOwner()
        || (resource.data.get('visibility', 'hidden') == 'public'
            && resource.data.get('classId', null) != null
            && isClassmateOf([resource.data.get('classId', null)]));
      allow write: if isOwner();
    }

    // --- submissions/{verificationId}_{studentUid} (M3-full, M3F-03) ---
    // Path-deterministic id: `${verificationId}_${studentUid}`. This is the
    // ONLY mechanism that guarantees one submission per (student,
    // verification) pair — Firestore Rules cannot run a query to check for
    // an existing duplicate, so uniqueness is enforced entirely by which
    // document id a create is even allowed to target.
    match /submissions/{submissionId} {
      // Create: only the very first draft, on the exact deterministic path,
      // for a verification that is active+public+onlineEnabled and assigned
      // to the student's own class. No privileged/arbitrary fields: the
      // exact key set is required, answers/flagged/attentionEvents must
      // start empty, deliveryCode/submittedAt must start null (a client
      // cannot create a submission that already looks submitted), and
      // ownerUid/verificationTitle/className must match the verification's
      // own data rather than whatever the client claims.
      allow create: if isApprovedStudent()
        && request.resource.data.keys().hasOnly([
             'submissionId', 'verificationId', 'studentUid', 'ownerUid', 'status',
             'answers', 'flagged', 'attentionEvents', 'deliveryCode',
             'verificationTitle', 'className', 'startedAt', 'lastSavedAt', 'submittedAt'
           ])
        && request.resource.data.keys().hasAll([
             'submissionId', 'verificationId', 'studentUid', 'ownerUid', 'status',
             'answers', 'flagged', 'attentionEvents', 'deliveryCode',
             'verificationTitle', 'className', 'startedAt', 'lastSavedAt', 'submittedAt'
           ])
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.submissionId == submissionId
        && submissionId == request.resource.data.verificationId + '_' + request.auth.uid
        && request.resource.data.answers.size() == 0
        && request.resource.data.flagged.size() == 0
        && request.resource.data.attentionEvents.size() == 0
        && request.resource.data.attentionEvents.size() <= 200
        && request.resource.data.deliveryCode == null
        && request.resource.data.submittedAt == null
        && request.resource.data.lastSavedAt == request.time
        && verificationOnlineAndActive(request.resource.data.verificationId)
        && verificationClassMatches(request.resource.data.verificationId)
        && request.resource.data.ownerUid
             == verificationData(request.resource.data.verificationId).ownerUid
        && request.resource.data.verificationTitle
             == verificationData(request.resource.data.verificationId).teacherSnapshot.title
        && request.resource.data.className
             == verificationData(request.resource.data.verificationId).teacherSnapshot.className;

      // Update: only the student's own submission, only while it is still
      // draft (this alone also blocks any 'submitted' -> 'draft' or any
      // further post-submission edit — no rule below ever matches a resource
      // whose status is already 'submitted'). Identity/verification/owner,
      // the title+class snapshot and the initial startedAt are immutable;
      // the only fields allowed to change are answers/flagged/
      // attentionEvents/lastSavedAt (autosave) plus status/deliveryCode/
      // submittedAt (delivery). The verification must still be
      // active+public+onlineEnabled and still assigned to the student's
      // class for either a draft autosave or the final delivery.
      //
      // Delivery (draft -> submitted) additionally requires, via getAfter(),
      // that the matching submissionReceipts/{submissionId} document exists
      // with coherent fields as of the SAME atomic write batch — this is
      // what makes "submit" and "create receipt" a single indivisible
      // operation: a submission can never end up 'submitted' without its
      // receipt, because getAfter() reflects the receipt write only when it
      // is part of the very same commit as this update.
      allow update: if isApprovedStudent()
        && resource.data.studentUid == request.auth.uid
        && resource.data.status == 'draft'
        && (request.resource.data.status == 'draft' || request.resource.data.status == 'submitted')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'status', 'answers', 'flagged', 'attentionEvents', 'lastSavedAt',
             'deliveryCode', 'submittedAt'
           ])
        && request.resource.data.submissionId == resource.data.submissionId
        && request.resource.data.verificationId == resource.data.verificationId
        && request.resource.data.studentUid == resource.data.studentUid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.verificationTitle == resource.data.verificationTitle
        && request.resource.data.className == resource.data.className
        && request.resource.data.startedAt == resource.data.startedAt
        && request.resource.data.lastSavedAt == request.time
        && request.resource.data.attentionEvents.size() <= 200
        && verificationOnlineAndActive(resource.data.verificationId)
        && verificationClassMatches(resource.data.verificationId)
        && (
          request.resource.data.status == 'draft'
            ? (request.resource.data.deliveryCode == null
                && request.resource.data.submittedAt == null)
            : (
                request.resource.data.deliveryCode is string
                && request.resource.data.submittedAt == request.time
                && getAfter(/databases/$(database)/documents/submissionReceipts/$(submissionId))
                     .data.studentUid == request.auth.uid
                && getAfter(/databases/$(database)/documents/submissionReceipts/$(submissionId))
                     .data.verificationId == resource.data.verificationId
                && getAfter(/databases/$(database)/documents/submissionReceipts/$(submissionId))
                     .data.ownerUid == resource.data.ownerUid
                && getAfter(/databases/$(database)/documents/submissionReceipts/$(submissionId))
                     .data.deliveryCode == request.resource.data.deliveryCode
                && getAfter(/databases/$(database)/documents/submissionReceipts/$(submissionId))
                     .data.submittedAt == request.resource.data.submittedAt
              )
        );

      // The owner may update the public correction-state mirror and/or the
      // owner-only score summary on an already submitted delivery. A state
      // change must still be mirrored to the sibling receipt in the same
      // commit. The score summary deliberately stays only on submissions.
      allow update: if isOwner()
        && resource.data.ownerUid == request.auth.uid
        && resource.data.status == 'submitted'
        && request.resource.data.status == 'submitted'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'correctionStatus', 'correctionStatusUpdatedAt',
               'correctionSummary', 'correctionSummaryUpdatedAt'
             ])
        && request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'correctionStatus', 'correctionStatusUpdatedAt',
             'correctionSummary', 'correctionSummaryUpdatedAt'
           ])
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['correctionStatus', 'correctionStatusUpdatedAt'])
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasAll(['correctionStatus', 'correctionStatusUpdatedAt'])
            && isValidSubmissionCorrectionStatus(request.resource.data.correctionStatus)
            && request.resource.data.correctionStatusUpdatedAt == request.time
            && publicCorrectionStatusMatchesCorrection(
                 submissionId, request.resource.data.correctionStatus)
            && getAfter(/databases/$(database)/documents/submissionReceipts/$(submissionId))
                 .data.get('correctionStatus', 'submitted')
                 == request.resource.data.correctionStatus
            && getAfter(/databases/$(database)/documents/submissionReceipts/$(submissionId))
                 .data.correctionStatusUpdatedAt == request.time
          )
        )
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['correctionSummary', 'correctionSummaryUpdatedAt'])
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasAll(['correctionSummary', 'correctionSummaryUpdatedAt'])
            && isValidSubmissionCorrectionSummary(request.resource.data.correctionSummary)
            && request.resource.data.correctionSummaryUpdatedAt == request.time
          )
        );

      // Get (M3F-04 preflight): startSubmission()/loadSubmission() call
      // getDoc() on the deterministic path BEFORE the document necessarily
      // exists — Firestore still evaluates read rules for a get() on a
      // missing document, and `resource` is simply `null` in that case
      // (never an evaluation error on its own). A student may fetch their
      // own path whether or not it exists yet, but once it does exist it
      // must still be `draft` — a submitted submission is never returned to
      // the student here. Deliberately `allow get`, not `allow read`: a
      // `list`/query can never satisfy this rule, only a single known-path
      // fetch, so this can't be used to enumerate submissions.
      allow get: if isApprovedStudent()
        && idBelongsToCaller(submissionId)
        && (resource == null || resource.data.status == 'draft');

      // The owner reads every submission for their own verifications
      // regardless of status (get and list both — a future monitor, M3F-05,
      // will list by ownerUid + verificationId).
      allow read: if isOwner() && resource.data.ownerUid == request.auth.uid;

      // M4-LIFE-02 — owner-only deletion of a submission and its personal data.
      // Ownership is checked from the document being deleted itself
      // (resource.data.ownerUid), never a sibling that could vanish in the same
      // pass. The student can never delete a submission.
      allow delete: if isOwner() && resource.data.ownerUid == request.auth.uid;
    }

    // --- submissionReceipts/{verificationId}_{studentUid} (M3-full, M3F-03) ---
    // Minimal post-submission document. Its whole purpose is to let the
    // student see a confirmation screen without ever reading the submission's
    // answers again once status == 'submitted'.
    match /submissionReceipts/{submissionId} {
      // Create: only as part of the same write batch that transitions the
      // matching submission to 'submitted' (see the update rule above) — the
      // getAfter() checks below require the submission to already show
      // status=='submitted' with matching fields as of this same commit, so
      // a receipt can never be fabricated without a real, simultaneous
      // draft -> submitted transition. Once created it can never be
      // targeted again by `create` (a second attempt is an `update`, denied
      // below), so this document is effectively write-once.
      allow create: if isApprovedStudent()
        && request.resource.data.keys().hasOnly([
             'submissionId', 'verificationId', 'studentUid', 'ownerUid',
             'verificationTitle', 'className', 'deliveryCode', 'submittedAt'
           ])
        && request.resource.data.keys().hasAll([
             'submissionId', 'verificationId', 'studentUid', 'ownerUid',
             'verificationTitle', 'className', 'deliveryCode', 'submittedAt'
           ])
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.submissionId == submissionId
        && submissionId == request.resource.data.verificationId + '_' + request.auth.uid
        && getAfter(/databases/$(database)/documents/submissions/$(submissionId))
             .data.status == 'submitted'
        && getAfter(/databases/$(database)/documents/submissions/$(submissionId))
             .data.studentUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/submissions/$(submissionId))
             .data.verificationId == request.resource.data.verificationId
        && getAfter(/databases/$(database)/documents/submissions/$(submissionId))
             .data.ownerUid == request.resource.data.ownerUid
        && getAfter(/databases/$(database)/documents/submissions/$(submissionId))
             .data.verificationTitle == request.resource.data.verificationTitle
        && getAfter(/databases/$(database)/documents/submissions/$(submissionId))
             .data.className == request.resource.data.className
        && getAfter(/databases/$(database)/documents/submissions/$(submissionId))
             .data.deliveryCode == request.resource.data.deliveryCode
        && getAfter(/databases/$(database)/documents/submissions/$(submissionId))
             .data.submittedAt == request.resource.data.submittedAt;

      // Get (M3F-04 preflight): loadReceipt() needs to check "does my receipt
      // exist yet" before a delivery has happened — same `resource == null`
      // idiom as the submissions get rule above. A receipt has no draft
      // concept, so once it exists it's simply readable by its own student
      // forever. `allow get`, not `allow read`, for the same reason as above.
      allow get: if isApprovedStudent()
        && idBelongsToCaller(submissionId)
        && (resource == null || resource.data.studentUid == request.auth.uid);
      allow read: if isOwner() && resource.data.ownerUid == request.auth.uid;

      // The immutable delivery fields never change. Only the owner may
      // atomically mirror the correction workflow state together with the
      // matching submitted submission.
      allow update: if isOwner()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['correctionStatus', 'correctionStatusUpdatedAt'])
        && isValidSubmissionCorrectionStatus(request.resource.data.correctionStatus)
        && request.resource.data.correctionStatusUpdatedAt == request.time
        && publicCorrectionStatusMatchesCorrection(
             submissionId, request.resource.data.correctionStatus)
        && getAfter(/databases/$(database)/documents/submissions/$(submissionId))
             .data.get('correctionStatus', 'submitted')
             == request.resource.data.correctionStatus
        && getAfter(/databases/$(database)/documents/submissions/$(submissionId))
             .data.correctionStatusUpdatedAt == request.time;
      // M4-LIFE-02 — owner-only receipt deletion (verified from the deleted doc).
      allow delete: if isOwner() && resource.data.ownerUid == request.auth.uid;
    }

    match /auditEvents/{docId} {
      allow read, write: if isOwner();
    }

    // --- corrections/{submissionId} (M4-01) ---
    // Same deterministic id as submissions/submissionReceipts — enforces the
    // 1:1 relationship by path alone, same reasoning as those collections.
    // Owner-only in every direction: unlike submissions, the student is
    // NEVER authorized here, not even in read (they read only
    // correctionReturns/{submissionId} once returned — see below).
    //
    // Boundary (documented once, applies to both corrections and
    // correctionEvents below): these Rules enforce ownership, identity,
    // top-level shape and the allowed status-transition graph — never a
    // deep validation of `evaluations`/`questionDeltas` map contents
    // (per-question point ranges, key-set completeness, delta correctness).
    // That validation is owner-only application logic
    // (`correctionContract.ts`, exercised by `correctionsService.ts`), not
    // a Rules concern: the caller who could tamper with it (the owner) is
    // the same principal Rules already trust for every other owner-write
    // path in this codebase (e.g. `teacherSnapshot`, `verifications.config`).
    match /corrections/{submissionId} {
      // Create: only once, only for a submitted submission owned by the
      // caller, identity fields pinned to that submission, always starting
      // 'in_progress' with reopenCount 0 and no completedAt/returnedAt yet.
      allow create: if isOwner()
        && exists(/databases/$(database)/documents/submissions/$(submissionId))
        && submissionData(submissionId).status == 'submitted'
        && submissionData(submissionId).ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'submissionId', 'verificationId', 'studentUid', 'ownerUid', 'status',
             'evaluations', 'generalFeedback', 'totalPoints', 'maxPoints', 'percentage',
             'createdAt', 'updatedAt', 'completedAt', 'returnedAt', 'reopenCount'
           ])
        && request.resource.data.keys().hasAll([
             'submissionId', 'verificationId', 'studentUid', 'ownerUid', 'status',
             'evaluations', 'generalFeedback', 'totalPoints', 'maxPoints', 'percentage',
             'createdAt', 'updatedAt', 'completedAt', 'returnedAt', 'reopenCount'
           ])
        && request.resource.data.submissionId == submissionId
        && request.resource.data.verificationId == submissionData(submissionId).verificationId
        && request.resource.data.studentUid == submissionData(submissionId).studentUid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'in_progress'
        && request.resource.data.reopenCount == 0
        && request.resource.data.completedAt == null
        && request.resource.data.returnedAt == null;

      // Update: identity (submissionId/verificationId/studentUid/ownerUid)
      // and createdAt are immutable forever. Only the workflow/scoring
      // fields may change, and only in one of two shapes:
      //   - a plain save while still 'in_progress' (status unchanged,
      //     reopenCount unchanged, completedAt/returnedAt stay whatever
      //     they already were — i.e. null);
      //   - a status transition that is a member of
      //     isValidCorrectionTransition, with reopenCount incremented by
      //     exactly 1 only on a transition back to 'in_progress', and
      //     completedAt/returnedAt set to request.time on the matching
      //     transition (or both cleared to null on reopen).
      allow update: if isOwner()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.submissionId == resource.data.submissionId
        && request.resource.data.verificationId == resource.data.verificationId
        && request.resource.data.studentUid == resource.data.studentUid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'status', 'evaluations', 'generalFeedback', 'totalPoints', 'maxPoints',
             'percentage', 'updatedAt', 'completedAt', 'returnedAt', 'reopenCount'
           ])
        && (
          request.resource.data.status == resource.data.status
            ? (
                resource.data.status == 'in_progress'
                  && request.resource.data.reopenCount == resource.data.reopenCount
                  && request.resource.data.completedAt == resource.data.completedAt
                  && request.resource.data.returnedAt == resource.data.returnedAt
              )
            : (
                isValidCorrectionTransition(resource.data.status, request.resource.data.status)
                  && (
                    request.resource.data.status == 'completed'
                      ? request.resource.data.reopenCount == resource.data.reopenCount
                          && request.resource.data.completedAt == request.time
                          && request.resource.data.returnedAt == resource.data.returnedAt
                      : request.resource.data.status == 'returned'
                        ? request.resource.data.reopenCount == resource.data.reopenCount
                            && request.resource.data.completedAt == resource.data.completedAt
                            && request.resource.data.returnedAt == request.time
                        : (
                            request.resource.data.status == 'in_progress'
                              && request.resource.data.reopenCount == resource.data.reopenCount + 1
                              && request.resource.data.completedAt == null
                              && request.resource.data.returnedAt == null
                          )
                  )
              )
        );

      // The owner must also be able to read this deterministic path before
      // the correction exists: openOrLoadCorrection uses the missing read to
      // decide whether it must create the first correction. Checking
      // resource.data.ownerUid here makes a missing document unreadable and
      // turns every first open into permission-denied. isOwner() already pins
      // the single trusted teacher account through settings/owner; create and
      // update keep their stricter identity checks above.
      allow read: if isOwner();
      // M4-LIFE-02 — owner-only correction deletion (verified from the deleted
      // doc). M5-06B — a correction that has been returned to the student is
      // permanent: deleting it is denied here (defence in depth behind the
      // service preflight), so a submission can only be erased before its first
      // return. in_progress / completed corrections stay deletable.
      allow delete: if isOwner()
        && resource.data.ownerUid == request.auth.uid
        && resource.data.status != 'returned'
        // A hidden prior return is removable only as part of the same
        // submission-graph deletion. A completed correction that was never
        // returned keeps the established direct-delete behaviour.
        && (
          !exists(/databases/$(database)/documents/correctionReturns/$(submissionId))
          || !existsAfter(/databases/$(database)/documents/correctionReturns/$(submissionId))
        );
    }

    // --- correctionEvents/{eventId} (M4-01) ---
    // Append-only audit trail. Auto-generated id (many events per
    // correction), so uniqueness/ordering isn't path-enforced — only that
    // every event is tied to a correction the caller actually owns.
    match /correctionEvents/{eventId} {
      allow create: if isOwner()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.actorUid == request.auth.uid
        && exists(/databases/$(database)/documents/corrections/$(request.resource.data.correctionId))
        && correctionData(request.resource.data.correctionId).ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly([
             'correctionId', 'ownerUid', 'type', 'actorUid', 'previousStatus', 'nextStatus',
             'reason', 'questionDeltas', 'generalFeedbackDelta', 'timestamp'
           ])
        && request.resource.data.keys().hasAll([
             'correctionId', 'ownerUid', 'type', 'actorUid', 'previousStatus', 'nextStatus',
             'reason', 'timestamp'
           ])
        && request.resource.data.type in ['reopened', 'scoreAdjusted', 'returned', 'correctionCleared']
        && request.resource.data.timestamp == request.time
        && isValidCorrectionEventTypeStatus(
             request.resource.data.type,
             request.resource.data.previousStatus,
             request.resource.data.nextStatus
           )
        && request.resource.data.nextStatus
             == correctionDataAfter(request.resource.data.correctionId).status;

      allow read: if isOwner() && resource.data.ownerUid == request.auth.uid;
      // Still append-only (no update). M4-LIFE-02 — owner-only deletion, so a
      // submission's correction history can be erased with its personal data;
      // verified from the deleted event's own ownerUid.
      allow update: if false;
      allow delete: if isOwner() && resource.data.ownerUid == request.auth.uid;
    }

    // --- correctionReturns/{submissionId} (M4-01) ---
    // Same deterministic id space as corrections/submissions. The ONE
    // student-readable document in the whole correction flow, and only
    // when visibleToStudent == true — existence of the document alone is
    // NOT sufficient (a reopened correction hides it immediately, without
    // deleting it, by flipping this field).
    match /correctionReturns/{submissionId} {
      // Both create and update require the correction to be 'returned' as
      // of AFTER this same atomic write (correctionDataAfter) — never just
      // "does a corrections doc exist". This is what makes returnCorrection
      // work (correction transitions to 'returned' in the very same batch
      // that creates/overwrites this projection) while denying any write
      // here while the correction is 'in_progress' or 'completed' —
      // including the two narrow toggles below, which must never re-surface
      // or grow a projection left stale by reopenCorrection.
      allow create: if isOwner()
        && exists(/databases/$(database)/documents/corrections/$(submissionId))
        && correctionData(submissionId).ownerUid == request.auth.uid
        && correctionDataAfter(submissionId).status == 'returned'
        && request.resource.data.keys().hasOnly([
             'correctionId', 'verificationId', 'studentUid', 'ownerUid', 'verificationTitle',
             'className', 'submittedAt', 'returnedAt', 'questions', 'generalFeedback',
             'totalPoints', 'maxPoints', 'percentage', 'visibleToStudent', 'solutionsVisible',
             'updatedAt'
           ])
        && request.resource.data.keys().hasAll([
             'correctionId', 'verificationId', 'studentUid', 'ownerUid', 'verificationTitle',
             'className', 'submittedAt', 'returnedAt', 'questions', 'generalFeedback',
             'totalPoints', 'maxPoints', 'percentage', 'visibleToStudent', 'solutionsVisible',
             'updatedAt'
           ])
        && request.resource.data.correctionId == submissionId
        && request.resource.data.verificationId == correctionData(submissionId).verificationId
        && request.resource.data.studentUid == correctionData(submissionId).studentUid
        && request.resource.data.ownerUid == request.auth.uid;

      // Update: covers a full rewrite on a later return (after a reopen ->
      // re-complete -> return cycle), the two narrow toggles
      // (visibleToStudent, solutionsVisible/questions), AND
      // reopenCorrection's own atomic hide — the ONE case where the
      // correction is deliberately leaving 'returned' in this same write.
      // That last case is narrowly scoped on purpose: it may only flip
      // visibleToStudent to false (plus updatedAt), never touch scoring
      // content, and only when the correction is actually transitioning
      // returned -> in_progress in this same batch — reopenCorrection is
      // the only caller that satisfies all three. Every other update
      // (including both toggle service functions, which now also
      // self-check client-side) requires the correction to be 'returned'
      // as of after this write — never merely that the projection exists,
      // per the documented Rules/service boundary above.
      allow update: if isOwner()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.correctionId == resource.data.correctionId
        && request.resource.data.verificationId == resource.data.verificationId
        && request.resource.data.studentUid == resource.data.studentUid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (
          correctionDataAfter(submissionId).status == 'returned'
            || (
              correctionData(submissionId).status == 'returned'
                && correctionDataAfter(submissionId).status == 'in_progress'
                && request.resource.data.diff(resource.data).affectedKeys()
                     .hasOnly(['visibleToStudent', 'updatedAt'])
                && request.resource.data.visibleToStudent == false
            )
        );

      // The return projection is optional until the docente actually returns
      // a completed correction. The workspace probes this deterministic path
      // on every load, so the owner must receive a normal missing-document
      // result instead of permission-denied when it does not exist yet.
      // isOwner() already identifies the single trusted teacher account;
      // student reads remain constrained by the separate rule below.
      allow read: if isOwner();

      // The student reads only their own projection, and only while the
      // docente has left it visible.
      allow read: if isApprovedStudent()
        && resource.data.studentUid == request.auth.uid
        && resource.data.visibleToStudent == true;

      // M4-LIFE-03: a projection is removable only with a real reopened
      // correction and the complete deterministic submission graph. A manual
      // hide is not enough: the correction must currently be in_progress and
      // all graph documents must be absent after this same atomic commit.
      allow delete: if isOwner()
        && resource.data.ownerUid == request.auth.uid
        && resource.data.visibleToStudent == false
        && exists(/databases/$(database)/documents/corrections/$(submissionId))
        && correctionData(submissionId).ownerUid == request.auth.uid
        && correctionData(submissionId).status == 'in_progress'
        && !existsAfter(/databases/$(database)/documents/corrections/$(submissionId))
        && !existsAfter(/databases/$(database)/documents/submissions/$(submissionId))
        && !existsAfter(/databases/$(database)/documents/submissionReceipts/$(submissionId));
    }

    // deliveryAttempts: owner can read (for corrections/export); writes via Cloud Functions (M3)
    match /deliveryAttempts/{docId} {
      allow read: if isOwner();
      allow write: if false;
    }
    match /deliveryAttempts/{docId}/{sub=**} {
      allow read: if isOwner();
      allow write: if false;
    }

    // --- Default deny ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
