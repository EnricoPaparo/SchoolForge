rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // Checks that the caller's uid matches the ownerUid stored in settings/owner.
    function isOwner() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/settings/owner)
        && request.auth.uid
           == get(/databases/$(database)/documents/settings/owner).data.ownerUid;
    }

    function studentPortalEnabled() {
      return exists(/databases/$(database)/documents/settings/studentAccess)
        && get(/databases/$(database)/documents/settings/studentAccess).data.studentPortalEnabled
           == true;
    }

    function newStudentRequestsEnabled() {
      return exists(/databases/$(database)/documents/settings/studentAccess)
        && get(/databases/$(database)/documents/settings/studentAccess).data.newStudentRequestsEnabled
           == true;
    }

    // A Google-authenticated non-owner is only a *candidate* student until
    // the teacher explicitly approves them here — being authenticated is
    // NEVER sufficient on its own to read student-facing content. Missing
    // settings/studentAccess, a missing students/{uid} document, or a
    // status other than 'approved' (pending/blocked) all deny by default.
    function isApprovedStudent() {
      return isAuthenticated()
        && studentPortalEnabled()
        && exists(/databases/$(database)/documents/students/$(request.auth.uid))
        && get(/databases/$(database)/documents/students/$(request.auth.uid)).data.status
           == 'approved';
    }

    // Only meaningful after isApprovedStudent() has confirmed
    // students/{uid} exists — callers must short-circuit on that first.
    // .get('classId', null) tolerates a legacy/partial document missing
    // the field, defaulting to "no class" rather than an evaluation error.
    function myStudentClassId() {
      return get(/databases/$(database)/documents/students/$(request.auth.uid))
        .data.get('classId', null);
    }

    // True only for an approved student (with the portal active) whose own
    // classId is one of the given classIds. `classIds` is always passed in
    // by the caller from resource/cross-doc data via .get('classIds', []),
    // so a program/lesson with no classIds field at all (legacy) or an
    // empty array both safely deny — never "visible to everyone" by
    // omission. A student with no classId of their own is denied too,
    // even if they are otherwise approved.
    function isClassmateOf(classIds) {
      return isApprovedStudent()
        && myStudentClassId() != null
        && classIds.hasAny([myStudentClassId()]);
    }

    // --- M3-full submission helpers (M3F-03) ---
    // Cross-document get() bypasses the read rules on /verifications/{docId}
    // itself (a student is never allowed a direct read there) — get()/exists()
    // in Rules evaluation always fetch the raw document server-side regardless
    // of what the caller's own read permissions would be. This mirrors the
    // publishedProjection class-gate pattern above, applied to submissions.
    function verificationData(verificationId) {
      return get(/databases/$(database)/documents/verifications/$(verificationId)).data;
    }

    // A submission may only be created/updated while its target verification
    // is simultaneously active, public and online-submittable. Closing the
    // verification (or ever toggling onlineEnabled off) immediately blocks
    // both new submissions and further edits to existing drafts, without any
    // change needed on the submission document itself.
    function verificationOnlineAndActive(verificationId) {
      return exists(/databases/$(database)/documents/verifications/$(verificationId))
        && verificationData(verificationId).status == 'active'
        && verificationData(verificationId).get('visibility', 'hidden') == 'public'
        && verificationData(verificationId).get('onlineEnabled', false) == true;
    }

    // Mirrors isClassmateOf(): independently re-checks isApprovedStudent() so
    // it stays safe to call on its own, not just after a caller-side guard.
    // config.classId is the source-of-truth class assignment (teacherSnapshot
    // duplicates it only for the student-facing title/className snapshot).
    function verificationClassMatches(verificationId) {
      return isApprovedStudent()
        && verificationData(verificationId).config.classId != null
        && verificationData(verificationId).config.classId == myStudentClassId();
    }

    // --- settings/owner ---
    // First authenticated user to write becomes the owner (no existing doc).
    // Subsequent updates/deletes require ownerUid match.
    match /settings/owner {
      allow read: if isOwner();
      allow create: if isAuthenticated()
                    && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isOwner();
    }

    // --- settings/ownerPublic (M3-lite) ---
    // Holds only `ownerUid`, readable by any authenticated user so the client
    // can resolve TeacherShell vs. StudentShell without exposing settings/owner
    // (classes, feature flags). Never authorizes anything on its own — every
    // protected resource above still checks isOwner() independently.
    // Created together with settings/owner during the same bootstrap claim.
    match /settings/ownerPublic {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.keys().hasOnly(['ownerUid'])
                    && request.resource.data.ownerUid == request.auth.uid
                    && !exists(/databases/$(database)/documents/settings/owner);
      allow update, delete: if isOwner();
    }

    // --- settings/studentAccess (M3-lite) ---
    // Global switches gating every student read (see isApprovedStudent()).
    // Readable by any authenticated user — same pattern as
    // settings/ownerPublic above: RoleGate needs studentPortalEnabled and
    // newStudentRequestsEnabled to decide which screen to show a candidate
    // student (disabled / pending / requests-closed), and neither flag is
    // sensitive or authorizes anything on its own. The actual content gate
    // (isApprovedStudent()) re-reads this document itself via get(), so a
    // client can never bypass authorization by trusting its own read.
    // Write stays owner-only.
    match /settings/studentAccess {
      allow read: if isAuthenticated();
      allow write: if isOwner();
    }

    // --- students/{uid} (M3-lite approval roster) ---
    // uid == the student's own Firebase Auth uid. A Google-authenticated
    // non-owner with no document here is treated as 'pending' for
    // authorization purposes. The teacher has full read/write. A student
    // may read only their own document (needed by RoleGate to show
    // pending/blocked/approved screens) and may create it exactly once,
    // as an unmodified 'pending' request, only while
    // newStudentRequestsEnabled is true — never approve/block/unblock
    // themselves, change classId, or read anyone else's document. Once
    // the document exists, every subsequent write is an `update`, which
    // only the owner can perform — so a student can never modify their
    // own status/classId/ownerUid after the initial request.
    match /students/{uid} {
      allow read: if isOwner() || (isAuthenticated() && request.auth.uid == uid);
      allow update, delete: if isOwner();
      allow create: if (isOwner() && request.resource.data.ownerUid == request.auth.uid)
        || (
          isAuthenticated()
          && request.auth.uid == uid
          && newStudentRequestsEnabled()
          && request.resource.data.uid == uid
          && request.resource.data.ownerUid
             == get(/databases/$(database)/documents/settings/ownerPublic).data.ownerUid
          && request.resource.data.status == 'pending'
          && request.resource.data.classId == null
          && request.resource.data.keys().hasOnly(
               ['uid', 'ownerUid', 'email', 'displayName', 'status', 'classId', 'createdAt',
                'updatedAt', 'lastLoginAt'])
        );
    }

    // --- Teacher-owned collections ---
    match /classes/{classId} {
      allow read, update, delete: if isOwner();
      allow create: if isOwner() && request.resource.data.ownerUid == request.auth.uid;
    }

    // --- programs/{docId} (M3-lite student read, M3L-C) ---
    // Owner: full read/write, as always. An approved student may also read
    // the top-level program document — never its imports/** subcollection
    // (technical lessons, questionIndex, pool: still owner-only via the
    // second match below) — but only when the program's own classIds
    // includes the student's classId. A program with no classIds, or an
    // empty one, is never readable by any student. This is the query the
    // student client runs to discover which programs it may see:
    // where('classIds', 'array-contains', myClassId) — the rule mirrors
    // that exact condition so Firestore can validate the list request.
    match /programs/{docId} {
      allow read, write: if isOwner();
      allow read: if isClassmateOf(resource.data.get('classIds', []));
    }
    match /programs/{programId}/{sub=**} {
      allow read, write: if isOwner();
    }

    // --- publicLessons (M3-lite) ---
    // Read-only projection of a lesson for the student portal. Never
    // contains poolStatus/poolStorageRef/questionCount or any pool-derived
    // field — see PublicLessonDoc. Owner: full read/write (written by the
    // import flow). Any other user: read-only, and only if they are an
    // approved student in the same class as the lesson's program
    // (isClassmateOf(), checked against the parent program's classIds via
    // get() — a lesson is never visible on its own, only through a program
    // the student's class is actually assigned to). Being an approved
    // student with the portal active is NOT enough by itself: without this
    // class check, any approved student could read every lesson of every
    // class, not just their own.
    //
    // Deliberately does NOT also check resource.data.ownerUid here (unlike
    // some other rules in this file): for a `list` query, Firestore can only
    // validate a condition against a field the query itself constrains
    // (here, only `programId` is), otherwise it cannot prove the query safe
    // and denies the whole request — the same reason the array-contains
    // "programs" rule above checks only classIds and nothing else. In this
    // single-docente system ownerUid is already implied by the program
    // lookup (a program only ever belongs to the one owner), so omitting it
    // costs nothing in practice.
    match /publicLessons/{lessonId} {
      allow read: if isOwner()
        || (
          exists(/databases/$(database)/documents/programs/$(resource.data.programId))
          && isClassmateOf(
               get(/databases/$(database)/documents/programs/$(resource.data.programId))
                 .data.get('classIds', []))
        );
      allow create, update: if isOwner() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if isOwner();
    }

    match /verifications/{docId} {
      allow read: if isOwner();
      // Delete allowed for draft (discard) and closed (tidy up) — active is
      // an immutable snapshot and can only be closed, never deleted.
      allow delete: if isOwner()
        && (resource.data.status == 'draft' || resource.data.status == 'closed');
      allow create: if isOwner() && request.resource.data.ownerUid == request.auth.uid;
      // Draft: any owner update allowed.
      // Active: only close allowed; only status/closedAt/updatedAt may change.
      // Active: only visibility toggled (M3-lite publish/hide); only
      // visibility/updatedAt may change, status must stay 'active'.
      // Closed: no updates allowed.
      allow update: if isOwner() && resource.data.status == 'draft';
      allow update: if isOwner()
        && resource.data.status == 'active'
        && request.resource.data.status == 'closed'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'closedAt', 'updatedAt']);
      allow update: if isOwner()
        && resource.data.status == 'active'
        && request.resource.data.status == 'active'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['visibility', 'updatedAt']);
    }
    match /verifications/{verificationId}/{sub=**} {
      // read: owner only; write on sub-collections handled per-path in later milestones.
      // Note: {sub=**} can match the document itself (zero segments), so write is intentionally
      // omitted here — update semantics on /verifications/{docId} are enforced above.
      allow read: if isOwner();
    }

    // --- verifications/{id}/publishedProjection (M3-lite, class gate M3L-D) ---
    // Solution-free projection written at activation. `classId` and
    // `visibility` ARE deliberately duplicated here from the parent
    // verification (see PublishedProjectionDoc for the full rationale) —
    // proven necessary, not just convenient: a student discovers matching
    // verifications via a single collectionGroup('publishedProjection')
    // query (the parent /verifications/{docId} is never readable — it holds
    // config.questionRefs/teacherSnapshot, which a student must never see).
    // Empirically, TWO things are required for Firestore to authorize that
    // collectionGroup `list`, neither obvious from the single-document `get`
    // case that worked before M3L-D:
    //   1. every field the rule authorizes on must also be a field the
    //      query itself filters on (a cross-document get() back to the
    //      parent, e.g. to check `status`, does not validate here — the
    //      parent path segment isn't constrained by the query);
    //   2. the match block itself must use a recursive-wildcard prefix
    //      ({path=**}) rather than a fixed-depth one
    //      (verifications/{verificationId}) — Firestore does not register
    //      a fixed-depth match as eligible for a bare collectionGroup()
    //      list at all (it still works fine for get()/writes on a known
    //      path, and for list within one already-known parent — just not
    //      for collectionGroup). Confirmed empirically: even
    //      `allow read: if true` failed list validation under the
    //      fixed-depth pattern, and succeeded once switched to {path=**}.
    // `visibility` therefore also stands in for `status` here:
    // setVerificationVisibility mirrors it, and closeVerification forces it
    // back to 'hidden' — see verificationsService.ts. isClassmateOf()
    // already requires isApprovedStudent() internally — a verification
    // with no classId (resource.data.get('classId', null) == null) is
    // never visible to any student, never "visible to everyone" by
    // omission, mirroring programs.classIds (M3L-C). The student's own
    // discovery query must mirror this exact rule shape:
    // where('classId','==',myClassId) AND where('visibility','==','public')
    // — see studentVerificationsService.ts.
    match /{path=**}/publishedProjection/{docId} {
      allow read: if isOwner()
        || (resource.data.get('visibility', 'hidden') == 'public'
            && resource.data.get('classId', null) != null
            && isClassmateOf([resource.data.get('classId', null)]));
      allow write: if isOwner();
    }

    // --- submissions/{verificationId}_{studentUid} (M3-full, M3F-03) ---
    // Path-deterministic id: `${verificationId}_${studentUid}`. This is the
    // ONLY mechanism that guarantees one submission per (student,
    // verification) pair — Firestore Rules cannot run a query to check for
    // an existing duplicate, so uniqueness is enforced entirely by which
    // document id a create is even allowed to target.
    match /submissions/{submissionId} {
      // Create: only the very first draft, on the exact deterministic path,
      // for a verification that is active+public+onlineEnabled and assigned
      // to the student's own class. No privileged/arbitrary fields: the
      // exact key set is required, answers/flagged/attentionEvents must
      // start empty, deliveryCode/submittedAt must start null (a client
      // cannot create a submission that already looks submitted), and
      // ownerUid/verificationTitle/className must match the verification's
      // own data rather than whatever the client claims.
      allow create: if isApprovedStudent()
        && request.resource.data.keys().hasOnly([
             'submissionId', 'verificationId', 'studentUid', 'ownerUid', 'status',
             'answers', 'flagged', 'attentionEvents', 'deliveryCode',
             'verificationTitle', 'className', 'startedAt', 'lastSavedAt', 'submittedAt'
           ])
        && request.resource.data.keys().hasAll([
             'submissionId', 'verificationId', 'studentUid', 'ownerUid', 'status',
             'answers', 'flagged', 'attentionEvents', 'deliveryCode',
             'verificationTitle', 'className', 'startedAt', 'lastSavedAt', 'submittedAt'
           ])
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.status == 'draft'
        && request.resource.data.submissionId == submissionId
        && submissionId == request.resource.data.verificationId + '_' + request.auth.uid
        && request.resource.data.answers.size() == 0
        && request.resource.data.flagged.size() == 0
        && request.resource.data.attentionEvents.size() == 0
        && request.resource.data.attentionEvents.size() <= 200
        && request.resource.data.deliveryCode == null
        && request.resource.data.submittedAt == null
        && request.resource.data.lastSavedAt == request.time
        && verificationOnlineAndActive(request.resource.data.verificationId)
        && verificationClassMatches(request.resource.data.verificationId)
        && request.resource.data.ownerUid
             == verificationData(request.resource.data.verificationId).ownerUid
        && request.resource.data.verificationTitle
             == verificationData(request.resource.data.verificationId).teacherSnapshot.title
        && request.resource.data.className
             == verificationData(request.resource.data.verificationId).teacherSnapshot.className;

      // Update: only the student's own submission, only while it is still
      // draft (this alone also blocks any 'submitted' -> 'draft' or any
      // further post-submission edit — no rule below ever matches a resource
      // whose status is already 'submitted'). Identity/verification/owner,
      // the title+class snapshot and the initial startedAt are immutable;
      // the only fields allowed to change are answers/flagged/
      // attentionEvents/lastSavedAt (autosave) plus status/deliveryCode/
      // submittedAt (delivery). The verification must still be
      // active+public+onlineEnabled and still assigned to the student's
      // class for either a draft autosave or the final delivery.
      //
      // Delivery (draft -> submitted) additionally requires, via getAfter(),
      // that the matching submissionReceipts/{submissionId} document exists
      // with coherent fields as of the SAME atomic write batch — this is
      // what makes "submit" and "create receipt" a single indivisible
      // operation: a submission can never end up 'submitted' without its
      // receipt, because getAfter() reflects the receipt write only when it
      // is part of the very same commit as this update.
      allow update: if isApprovedStudent()
        && resource.data.studentUid == request.auth.uid
        && resource.data.status == 'draft'
        && (request.resource.data.status == 'draft' || request.resource.data.status == 'submitted')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'status', 'answers', 'flagged', 'attentionEvents', 'lastSavedAt',
             'deliveryCode', 'submittedAt'
           ])
        && request.resource.data.submissionId == resource.data.submissionId
        && request.resource.data.verificationId == resource.data.verificationId
        && request.resource.data.studentUid == resource.data.studentUid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.verificationTitle == resource.data.verificationTitle
        && request.resource.data.className == resource.data.className
        && request.resource.data.startedAt == resource.data.startedAt
        && request.resource.data.lastSavedAt == request.time
        && request.resource.data.attentionEvents.size() <= 200
        && verificationOnlineAndActive(resource.data.verificationId)
        && verificationClassMatches(resource.data.verificationId)
        && (
          request.resource.data.status == 'draft'
            ? (request.resource.data.deliveryCode == null
                && request.resource.data.submittedAt == null)
            : (
                request.resource.data.deliveryCode is string
                && request.resource.data.submittedAt == request.time
                && getAfter(/databases/$(database)/documents/submissionReceipts/$(submissionId))
                     .data.studentUid == request.auth.uid
                && getAfter(/databases/$(database)/documents/submissionReceipts/$(submissionId))
                     .data.verificationId == resource.data.verificationId
                && getAfter(/databases/$(database)/documents/submissionReceipts/$(submissionId))
                     .data.ownerUid == resource.data.ownerUid
                && getAfter(/databases/$(database)/documents/submissionReceipts/$(submissionId))
                     .data.deliveryCode == request.resource.data.deliveryCode
                && getAfter(/databases/$(database)/documents/submissionReceipts/$(submissionId))
                     .data.submittedAt == request.resource.data.submittedAt
              )
        );

      // Read: the student sees their own submission only while it is still
      // draft — once submitted, they read only the matching
      // submissionReceipts/{submissionId} (see below), never the full
      // submission with its answers again. The owner reads every submission
      // for their own verifications regardless of status.
      allow read: if isApprovedStudent()
        && resource.data.studentUid == request.auth.uid
        && resource.data.status == 'draft';
      allow read: if isOwner() && resource.data.ownerUid == request.auth.uid;

      // No deletion in M3F-03 (M4 may add archiving later).
      allow delete: if false;
    }

    // --- submissionReceipts/{verificationId}_{studentUid} (M3-full, M3F-03) ---
    // Minimal post-submission document. Its whole purpose is to let the
    // student see a confirmation screen without ever reading the submission's
    // answers again once status == 'submitted'.
    match /submissionReceipts/{submissionId} {
      // Create: only as part of the same write batch that transitions the
      // matching submission to 'submitted' (see the update rule above) — the
      // getAfter() checks below require the submission to already show
      // status=='submitted' with matching fields as of this same commit, so
      // a receipt can never be fabricated without a real, simultaneous
      // draft -> submitted transition. Once created it can never be
      // targeted again by `create` (a second attempt is an `update`, denied
      // below), so this document is effectively write-once.
      allow create: if isApprovedStudent()
        && request.resource.data.keys().hasOnly([
             'submissionId', 'verificationId', 'studentUid', 'ownerUid',
             'verificationTitle', 'className', 'deliveryCode', 'submittedAt'
           ])
        && request.resource.data.keys().hasAll([
             'submissionId', 'verificationId', 'studentUid', 'ownerUid',
             'verificationTitle', 'className', 'deliveryCode', 'submittedAt'
           ])
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.submissionId == submissionId
        && submissionId == request.resource.data.verificationId + '_' + request.auth.uid
        && getAfter(/databases/$(database)/documents/submissions/$(submissionId))
             .data.status == 'submitted'
        && getAfter(/databases/$(database)/documents/submissions/$(submissionId))
             .data.studentUid == request.auth.uid
        && getAfter(/databases/$(database)/documents/submissions/$(submissionId))
             .data.verificationId == request.resource.data.verificationId
        && getAfter(/databases/$(database)/documents/submissions/$(submissionId))
             .data.ownerUid == request.resource.data.ownerUid
        && getAfter(/databases/$(database)/documents/submissions/$(submissionId))
             .data.verificationTitle == request.resource.data.verificationTitle
        && getAfter(/databases/$(database)/documents/submissions/$(submissionId))
             .data.className == request.resource.data.className
        && getAfter(/databases/$(database)/documents/submissions/$(submissionId))
             .data.deliveryCode == request.resource.data.deliveryCode
        && getAfter(/databases/$(database)/documents/submissions/$(submissionId))
             .data.submittedAt == request.resource.data.submittedAt;

      allow read: if isApprovedStudent() && resource.data.studentUid == request.auth.uid;
      allow read: if isOwner() && resource.data.ownerUid == request.auth.uid;

      // Never modifiable or deletable — it is the immutable proof of a
      // one-time delivery.
      allow update, delete: if false;
    }

    match /auditEvents/{docId} {
      allow read, write: if isOwner();
    }

    match /corrections/{docId} {
      allow read, write: if isOwner();
    }
    match /correctionEvents/{docId} {
      allow read, write: if isOwner();
    }

    // deliveryAttempts: owner can read (for corrections/export); writes via Cloud Functions (M3)
    match /deliveryAttempts/{docId} {
      allow read: if isOwner();
      allow write: if false;
    }
    match /deliveryAttempts/{docId}/{sub=**} {
      allow read: if isOwner();
      allow write: if false;
    }

    // --- Default deny ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
