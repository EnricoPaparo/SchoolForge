{
  "name": "@schoolforge/functions",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "./lib/index.js",
  "scripts": {
    "build": "tsc",
    "benchmark:m5-quality": "node lib/m5QualityBenchmarkCli.js",
    "benchmark:m5-quality:compare": "node lib/m5ModelComparisonCli.js",
    "benchmark:m5-quality:reevaluate": "node lib/m5ReevaluateCli.js",
    "benchmark:lesson-manual-quality": "node lib/lessonManualQualityCli.js",
    "benchmark:lesson-tune-quality": "node lib/lessonTuneQualityCli.js",
    "benchmark:pool-tune": "node lib/poolTuneCli.js",
    "benchmark:visual-quality": "node lib/visualQualityCli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:firestore-integration": "vitest run --no-file-parallelism src/aiVisualFirestore.integration.test.ts src/aiVisualPromotion.integration.test.ts src/aiVisualLifecycle.integration.test.ts src/aiVisualExport.integration.test.ts src/aiVisualEndToEnd.integration.test.ts src/aiVisualCostModel.integration.test.ts src/aiVisualReanchor.integration.test.ts src/aiVisualUploadGateway.integration.test.ts src/aiVisualPlanExecution.integration.test.ts"
  },
  "dependencies": {
    "@schoolforge/lesson-contract": "file:./vendor/lesson-contract",
    "firebase-admin": "^14.1.0",
    "firebase-functions": "^7.3.0",
    "openai": "^6.47.0",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.2",
    "vitest": "^1.6.1"
  },
  "engines": {
    "node": "22"
  }
}
