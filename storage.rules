rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Student lesson content is the second hop of the M3-lite flow.
    // Firestore rules already gate discovery of programs/publicLessons by:
    // - student portal toggle;
    // - approved student status;
    // - assigned classId;
    // - program.classIds compatibility.
    //
    // Production Storage Rules are stricter than our emulator tests around
    // cross-service Firestore reads. Keep Storage to one Firestore read:
    // students/{uid}. It verifies that the caller is still an approved
    // student with an assigned class, then serves only lesson Markdown files
    // exposed through publicLessons.contentPath. Pool files stay denied.
    function isApprovedAssignedStudent() {
      let student = firestore.get(/databases/(default)/documents/students/$(request.auth.uid));
      return student.data.status == 'approved'
        && student.data.get('classId', null) != null;
    }

    // Student read path for imported lesson Markdown:
    // repository/{ownerUid}/imports/{importId}/{udaDir}/{fileName}
    match /repository/{ownerUid}/imports/{importId}/{udaDir}/{fileName} {
      allow read: if request.auth != null
        && request.auth.uid != ownerUid
        && isApprovedAssignedStudent()
        && fileName.matches('.*\\.md')
        && !fileName.matches('.*\\.pool\\.md');
    }

    // Owner keeps full control over repository files and pools.
    match /repository/{ownerUid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == ownerUid;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
