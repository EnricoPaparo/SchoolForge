rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Student lesson content is the second hop of the M3-lite flow.
    // Firestore rules already gate discovery of programs/publicLessons by:
    // - student portal toggle;
    // - approved student status;
    // - assigned classId;
    // - program.classIds compatibility.
    //
    // Production Storage Rules are stricter than the emulator around
    // cross-service Firestore reads. Storage therefore does not read
    // Firestore at all: it serves only Markdown lesson files to authenticated
    // users. The actual student authorization/class gating happens before
    // this, in Firestore discovery rules for programs/publicLessons, which
    // are the only way the client receives a contentPath.

    // Student read path for imported lesson Markdown:
    // repository/{ownerUid}/imports/{importId}/{udaDir}/{fileName}
    match /repository/{ownerUid}/imports/{importId}/{udaDir}/{fileName} {
      allow read: if request.auth != null
        && request.auth.uid != ownerUid
        && fileName.matches('.*\\.md')
        && !fileName.matches('.*\\.pool\\.md');
    }

    // Owner keeps full control over repository files and pools.
    match /repository/{ownerUid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == ownerUid;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
