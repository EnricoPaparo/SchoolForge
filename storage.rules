rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // M3F-08: the student-facing "second hop" that used to grant any
    // authenticated non-owner a direct read of imported lesson Markdown is
    // REMOVED. Storage now serves the repository tree — Markdown and pool
    // files alike — only to its owner. The student portal reads the lesson
    // body exclusively from `publicLessons/{id}.content` (a Firestore
    // projection, still gated by the existing discovery rules: portal
    // toggle, approved status, assigned classId, program.classIds
    // compatibility, Modalità verifica) — see studentLessonsService.ts.
    // A student who somehow still knew/cached a contentPath from before this
    // change gets a plain permission-denied here now, closing the M3F-07
    // interim gap (see sicurezza.md §3.2a) for good. No cross-service
    // firestore.get()/exists() calls are introduced — this file still never
    // reads Firestore at all, it simply stops granting a second, unguarded
    // path to the same content.

    // Owner keeps full control over repository files and pools.
    match /repository/{ownerUid}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == ownerUid;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
