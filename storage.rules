rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // M3F-08: the student-facing "second hop" that used to grant any
    // authenticated non-owner a direct read of imported lesson Markdown is
    // REMOVED. Storage now serves the repository tree — Markdown and pool
    // files alike — only to its owner. The student portal reads the lesson
    // body exclusively from `publicLessons/{id}.content` (a Firestore
    // projection, still gated by the existing discovery rules: portal
    // toggle, approved status, assigned classId, program.classIds
    // compatibility, Modalità verifica) — see studentLessonsService.ts.
    // A student who somehow still knew/cached a contentPath from before this
    // change gets a plain permission-denied here now, closing the M3F-07
    // interim gap (see sicurezza.md §3.2a) for good. No cross-service
    // firestore.get()/exists() calls are introduced — this file still never
    // reads Firestore at all, it simply stops granting a second, unguarded
    // path to the same content.

    // VISUAL-ENRICHMENT-03C: i binari visuali non sono raggiungibili da alcun
    // client, **nemmeno dal docente proprietario**.
    //
    // Non toglie nulla a nessuno: il runtime web non legge Storage direttamente
    // da SGW-02C, e l'unico percorso previsto verso questi byte è la callable
    // `aiVisualExportBatch`, che passa dall'Admin SDK — il quale bypassa queste
    // regole — dopo aver verificato proprietà, manifest, hash e dimensioni.
    // Lasciare aperta una seconda porta significava avere una lettura non
    // verificata accanto a una verificata.
    //
    // **Perché una condizione e non un `match` più specifico.** Le regole
    // Storage combinano i match in OR: un `match` dedicato che negasse non
    // vincerebbe sulla regola ricorsiva del repository, che continuerebbe a
    // concedere. L'esclusione deve quindi stare *dentro* la condizione che
    // concede. Il confronto è su `resource.name`/`request.resource.name` perché
    // i wildcard di tipo Path non espongono `matches()`.
    function isVisualObject() {
      return (resource != null && resource.name.matches('.*/visuals/.*'))
        || (request.resource != null && request.resource.name.matches('.*/visuals/.*'));
    }

    // Owner keeps full control over repository files and pools.
    match /repository/{ownerUid}/{allPaths=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == ownerUid
        && !isVisualObject();
    }

    // VISUAL-ENRICHMENT-02: staging accessibile esclusivamente via Admin SDK.
    match /staging/{ownerUid}/{objectName} {
      allow read, write: if false;
    }

    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
